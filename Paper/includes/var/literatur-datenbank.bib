@article{egwutuohaSurveyFaultTolerance2013,
  title        = {A Survey of Fault Tolerance Mechanisms and Checkpoint/Restart Implementations for High Performance Computing Systems},
  author       = {Egwutuoha, Ifeanyi P. and Levy, David and Selic, Bran and Chen, Shiping},
  date         = {2013-09-01},
  journaltitle = {J Supercomput},
  volume       = {65},
  number       = {3},
  pages        = {1302--1326},
  issn         = {1573-0484},
  doi          = {10.1007/s11227-013-0884-0},
  url          = {https://doi.org/10.1007/s11227-013-0884-0},
  urldate      = {2023-10-03},
  abstract     = {In recent years, High Performance Computing (HPC) systems have been shifting from expensive massively parallel architectures to clusters of commodity PCs to take advantage of cost and performance benefits. Fault tolerance in such systems is a growing concern for long-running applications. In this paper, we briefly review the failure rates of HPC systems and also survey the fault tolerance approaches for HPC systems and issues with these approaches. Rollback-recovery techniques which are most often used for long-running applications on HPC clusters are discussed because they are widely used for long-running applications on HPC systems. Specifically, the feature requirements of rollback-recovery are discussed and a taxonomy is developed for over twenty popular checkpoint/restart solutions. The intent of this paper is to aid researchers in the domain as well as to facilitate development of new checkpointing solutions.},
  langid       = {english},
  keywords     = {Checkpoint/restart,Clusters,Fault tolerance,High Performance Computing (HPC),Performance,Reliability},
}

@thesis{eickhoffTopologyAwareWorkloadAnalyzer,
  title    = {A {{Topology-Aware Workload Analyzer}} for {{High-Performance Computing Applications}}},
  author   = {Eickhoff, Linus},
  abstract = {In this study, we introduce a topology-aware workload analyzer tailored to the Hawk supercomputer, which operates on an enhanced 9D hypercube topology. Addressing the central concern of inefficiencies arising from the improper utilization of resources, manifesting in topologically inefficient communication patterns, we delve into the foundational theory about network topologies, workload analysis, Hawk’s infrastructure, and its associated software. Anchored in extensive literature reviews and theory, we establish a robust methodology for data collection, processing, and visualization. Building on this foundation, we implement the topology-aware workload analyzer in Python, capable of generating insightful analysis diagrams and performing a concise automated analysis that is deployable as a job report. A deep dive into the general communication patterns on Hawk lead to the conceptual- ization of the Quadrant Efficiency η metric as an elegant way to quantify efficiency in routing heatmaps of hypercube topologies. In subsequent job analyses, we compare job communication patterns to give guidance for analyzing topological efficiency. Additionally, a thorough examination of prevalent MPI collectives and algorithms uncovers structural inefficiencies, which potentially account for inefficiencies observed in jobs. These findings provide significant insights into potential sources of topological inefficiency. This work not only emphasizes the importance of topology-aware workload analysis but also solidifies its role as an important step in advancing the efficiency and understanding of HPC systems.},
  langid   = {english},
}

@unpublished{enthoughtArkoudaTerascaleData2020,
  title      = {Arkouda: {{Terascale Data Science}} at {{Interactive Rates}} |{{SciPy}} 2020| {{Ben Albrecht}}},
  shorttitle = {Arkouda},
  author     = {{Enthought}},
  date       = {2020-07-05},
  url        = {https://www.youtube.com/watch?v=Rqak62zNOxE},
  urldate    = {2024-04-09},
  abstract   = {This talk will describe Arkouda, a Python package that we have developed for doing exploratory analysis on massive data sets at interactive rates. Arkouda's API is based on NumPy/Pandas, yet its arrays can be transparently distributed across the compute nodes of a cluster or supercomputer to support large-scale analytics. In our work, we have run Arkouda operations from Jupyter notebooks on TB-sized data sets in seconds to small numbers of minutes—achieving scalability and performance that we have not observed with competing technologies. This talk will introduce Arkouda and its design while also encouraging others to use or extend its open-source implementation. ***************** ~~/~enthought~~ ~~/~enthought~~ ~~/~enthought}
}

