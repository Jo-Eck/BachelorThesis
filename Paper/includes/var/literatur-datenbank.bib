@article{gomaaImpactRapidPrototyping1983,
  title        = {The Impact of Rapid Prototyping on Specifying User Requirements},
  author       = {Gomaa, Hassan},
  date         = {1983-04-01},
  journaltitle = {SIGSOFT Softw. Eng. Notes},
  volume       = {8},
  number       = {2},
  pages        = {17--27},
